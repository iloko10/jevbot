# Leave empty to run on stub rules. Add your key when TypeSafe approves you.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

COIN=BTC
TICK_MS=1000

# On Railway, mount a volume at /data so logs survive redeploys
DB_PATH=/data/jevbot.db

# Spread tests: extra paper books quoting wider, to see which spread beats the fees
SPREAD_TESTS_BPS=3,5,8
# HYPE staking discount (0.05 = 5% for >10 HYPE staked). Fee tier by volume is automatic.
FEE_DISCOUNT=0

# Hard risk limits (paper money, USD and BTC)
MAX_POSITION=0.02
MAX_ORDER_SIZE=0.005
QUOTE_SIZE=0.002
MAX_DAILY_LOSS=50
MAX_DRAWDOWN=75
